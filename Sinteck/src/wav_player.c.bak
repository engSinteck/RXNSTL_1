#include "FreeRTOS.h"
#include "task.h"
#include "cmsis_os.h"
#include "semphr.h"
#include "i2s.h"
#include "fatfs.h"
#include "wav_player.h"
#include "../Sinteck/src/sine_generator.h"

// Buffers de DMA
__attribute__((section(".RAM_D2"))) int32_t audio_dma_buffer[TOTAL_BUFFER_WORDS];

// Semáforos
SemaphoreHandle_t half_buffer_ready_semaphore = NULL;
SemaphoreHandle_t full_buffer_ready_semaphore = NULL;

// Player global
static wav_player_t wav_player = {0};
static TaskHandle_t audio_task_handle = NULL;
static SemaphoreHandle_t audio_start_semaphore = NULL;

// Ponteiro para o half-buffer atual (0 = primeira metade, 1 = segunda metade)
static volatile uint8_t current_half_buffer = 0;

static uint32_t test_phase = 0;
static uint8_t header_wav[44] = {0};

// ============================================
// Gerador TOM
// ============================================
static void generate_test_tone(int32_t* buffer, uint32_t samples)
{
    // Gera um tom de 440Hz (Lá) para teste
    for(uint32_t i = 0; i < samples; i++) {
        int16_t sample = (int16_t)(16384 * sin(2 * 3.14159 * 440 * test_phase / 48000.0));
        test_phase++;

        // Converte para formato I2S (16 bits alinhado à esquerda)
        buffer[i] = ((uint32_t)sample << 16) | ((uint32_t)sample & 0xFFFF);
    }
}

void Audio_StartTestTone(void)
{
    test_phase = 0;

    // Pré-enche ambos os half-buffers com o tom de teste
    generate_test_tone(&audio_dma_buffer[0], HALF_BUFFER_SAMPLES);
    SCB_CleanDCache_by_Addr((uint32_t*)&audio_dma_buffer[0], HALF_BUFFER_SAMPLES * 4);

    generate_test_tone(&audio_dma_buffer[HALF_BUFFER_SAMPLES], HALF_BUFFER_SAMPLES);
    SCB_CleanDCache_by_Addr((uint32_t*)&audio_dma_buffer[HALF_BUFFER_SAMPLES], HALF_BUFFER_SAMPLES * 4);

    // Inicia DMA se não estiver rodando
    HAL_I2S_Transmit_DMA(&hi2s2, (uint16_t*)audio_dma_buffer, TOTAL_BUFFER_WORDS);

    wav_player.is_playing = 1;

    // Cria task
    if(audio_task_handle == NULL) {
        xTaskCreate(vAudioPlayerTask, "WAVTone", 4096, NULL, configMAX_PRIORITIES - 1, &audio_task_handle);
    }
}
// ============================================
// INICIALIZAÇÃO
// ============================================
void Audio_Init(void)
{
    // Cria semáforos
    half_buffer_ready_semaphore = xSemaphoreCreateBinary();
    full_buffer_ready_semaphore = xSemaphoreCreateBinary();

    // Inicialmente, ambos semáforos estão vazios
    // Limpa o buffer DMA
    memset((void*)audio_dma_buffer, 0, sizeof(audio_dma_buffer));

    // Limpa cache antes do DMA começar
//    SCB_CleanDCache_by_Addr((uint32_t*)audio_dma_buffer, sizeof(audio_dma_buffer));

    // Inicia DMA em modo CIRCULAR
//    HAL_I2S_Transmit_DMA(&hi2s2, (uint16_t*)audio_dma_buffer, TOTAL_BUFFER_WORDS);

    // O DMA agora está rodando, mas com buffer vazio (silêncio)
    // Os callbacks HalfCplt e Cplt serão chamados automaticamente

    // Cria semáforo para controle de start
    audio_start_semaphore = xSemaphoreCreateBinary();
    if(audio_start_semaphore == NULL) {
        // Erro ao criar semáforo
        return;
    }

    // Sinaliza a task para começar (AGORA a task já está esperando)
    xSemaphoreGive(audio_start_semaphore);

    Minimal_Tone_Test();
}

// ============================================
// PREENCHIMENTO DO BUFFER COM TOM
// ============================================
static uint32_t fill_audio_tom(int32_t* buffer, uint32_t max_words)
{
    // TESTE: Ignora arquivo e gera um tom de 440Hz
    static uint32_t phase = 0;
    uint32_t max_frames = max_words / 2;

    for(uint32_t i = 0; i < max_frames; i++) {
        // Gera onda senoidal
        int16_t sample = (int16_t)(16384 * sin(2 * 3.14159 * 440 * phase / 48000.0));
        phase++;

        // Mesmo formato do tom que funciona
        buffer[i * 2]     = ((int32_t)sample) << 16;
        buffer[i * 2 + 1] = ((int32_t)sample) << 16;
    }

    return max_frames;  // Simula que leu todos os frames
}
// ============================================
// PREENCHIMENTO DO BUFFER COM DADOS DO WAV
// ============================================
// audio_player.c - Versão corrigida
static uint32_t fill_audio_buffer(int32_t* buffer, uint32_t max_words)
{
    if(!wav_player.is_playing || !wav_player.file_is_open) {
        return 0;
    }

    if(wav_player.data_remaining == 0) {
        return 0;
    }

    // max_words é o número de words (32 bits) que o buffer pode receber
    // Cada frame estéreo = 2 words (L e R separados)
    uint32_t max_frames = max_words / 2;
    uint32_t bytes_needed = max_frames * 4;  // 4 bytes por frame estéreo (L+R 16bits cada)
    uint32_t bytes_to_read = (bytes_needed > wav_player.data_remaining) ?
                              wav_player.data_remaining : bytes_needed;

    if(bytes_to_read == 0) {
        return 0;
    }

    // Buffer temporário para dados PCM crus
    uint8_t pcm_buffer[2048];
    if(bytes_to_read > sizeof(pcm_buffer)) {
        bytes_to_read = sizeof(pcm_buffer);
    }

    // Lê do arquivo FATFS
    UINT bytes_read;
    FRESULT result = f_read(&wav_player.file, pcm_buffer, bytes_to_read, &bytes_read);

    if(result != FR_OK || bytes_read == 0) {
        return 0;
    }

    // Converte PCM 16-bit para formato I2S (mesmo formato do tom de teste)
    uint16_t* pcm16 = (uint16_t*)pcm_buffer;
    uint32_t frames_read = bytes_read / 4;  // Cada frame = 2 words (L+R)

    for(uint32_t i = 0; i < frames_read && i < max_frames; i++) {
        int16_t left = (int16_t)pcm16[i * 2];
        int16_t right = (int16_t)pcm16[i * 2 + 1];

        // Formato: cada word é um canal, 16 bits alinhado à esquerda
        buffer[i * 2]     = ((int32_t)left) << 16;   // Canal Left
        buffer[i * 2 + 1] = ((int32_t)right) << 16;  // Canal Right
    }

    wav_player.data_remaining -= bytes_read;

    return frames_read;  // Retorna número de frames (não words)
}

// ============================================
// CALLBACKS DO DMA (INTERRUPÇÕES)
// ============================================
void HAL_I2S_TxHalfCpltCallback(I2S_HandleTypeDef *hi2s)
{
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    // Toggle GPIO
    HAL_GPIO_TogglePin(LED_LOCK_GPIO_Port, LED_LOCK_Pin);

    // Metade do buffer terminou (primeiros HALF_BUFFER_SAMPLES words)
    // Sinaliza para a task preencher a PRIMEIRA metade do buffer
    current_half_buffer = 0;
    xSemaphoreGiveFromISR(half_buffer_ready_semaphore, &xHigherPriorityTaskWoken);

    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
}

void HAL_I2S_TxCpltCallback(I2S_HandleTypeDef *hi2s)
{
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    // Toggle GPIO
    HAL_GPIO_TogglePin(LED_RSSI_GPIO_Port, LED_RSSI_Pin);

    // Buffer completo terminou (segunda metade acabou de tocar)
    // Sinaliza para a task preencher a SEGUNDA metade do buffer
    current_half_buffer = 1;
    xSemaphoreGiveFromISR(full_buffer_ready_semaphore, &xHigherPriorityTaskWoken);

    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
}

void vAudioPlayerTask(void *pvParameters) {
    uint32_t frames_written;

    // Pré-enche ambas as metades
    fill_audio_buffer(&audio_dma_buffer[0], HALF_BUFFER_WORDS);
    fill_audio_buffer(&audio_dma_buffer[HALF_BUFFER_WORDS], HALF_BUFFER_WORDS);
    SCB_CleanDCache_by_Addr((uint32_t*)audio_dma_buffer, sizeof(audio_dma_buffer));

    while(wav_player.is_playing) {
        // Aguarda primeira metade precisar ser preenchida
        if(xSemaphoreTake(half_buffer_ready_semaphore, pdMS_TO_TICKS(100)) == pdTRUE) {
            frames_written = fill_audio_buffer(&audio_dma_buffer[0], HALF_BUFFER_WORDS);

            if(frames_written > 0) {
                uint32_t words_written = frames_written * 2;
                if(words_written < HALF_BUFFER_WORDS) {
                    memset(&audio_dma_buffer[words_written], 0,
                           (HALF_BUFFER_WORDS - words_written) * 4);
                }
                SCB_CleanDCache_by_Addr((uint32_t*)&audio_dma_buffer[0], HALF_BUFFER_WORDS * 4);
            } else {
                break;
            }
        }

        // Aguarda segunda metade precisar ser preenchida
        if(xSemaphoreTake(full_buffer_ready_semaphore, pdMS_TO_TICKS(100)) == pdTRUE) {
            frames_written = fill_audio_buffer(&audio_dma_buffer[HALF_BUFFER_WORDS], HALF_BUFFER_WORDS);

            if(frames_written > 0) {
                uint32_t words_written = frames_written * 2;
                if(words_written < HALF_BUFFER_WORDS) {
                    memset(&audio_dma_buffer[HALF_BUFFER_WORDS + words_written], 0,
                           (HALF_BUFFER_WORDS - words_written) * 4);
                }
                SCB_CleanDCache_by_Addr((uint32_t*)&audio_dma_buffer[HALF_BUFFER_WORDS], HALF_BUFFER_WORDS * 4);
            } else {
                break;
            }
        }
    }

    Audio_StopPlayback();
}

