        //printf("Bits per sample: %d\n", header[34]);
        //printf("Channels: %d\n", header[22]);

        f_close(&file);
    }
}

void Minimal_Tone_Test(void)
{
    // Teste I2S @ 48KHz - 16Bit
    generate_sine_table();
    fill_i2s_buffer();
    Send_I2S_buffer();
}
