// ============================================
// CONTROLE DO PLAYER
// ============================================
static uint8_t open_wav_file(const char* filename)
{
    FRESULT result;

    // Fecha arquivo anterior se estiver aberto
    if(wav_player.file_is_open) {
        f_close(&wav_player.file);
        wav_player.file_is_open = 0;
    }

    // Abre arquivo
    result = f_open(&wav_player.file, filename, FA_READ);
    if(result != FR_OK) {
        return 0;
    }

    wav_player.file_is_open = 1;  // Marca como aberto

    // Pula header WAV (assume formato PCM padrão)
    f_lseek(&wav_player.file, 44);

    // Calcula tamanho dos dados
    wav_player.data_remaining = f_size(&wav_player.file) - 44;
    wav_player.is_playing = 1;

    return 1;
}

// ============================================
// PARAR PLAYBACK (CORRIGIDO)
// ============================================
void Audio_StopPlayback(void) {
    wav_player.is_playing = 0;

    // Fecha arquivo se estiver aberto
    if(wav_player.file_is_open) {
        f_close(&wav_player.file);
        wav_player.file_is_open = 0;
    }

    // Pausa o DMA para evitar ruídos
    HAL_I2S_DMAPause(&hi2s2);

    // Preenche buffers com silêncio
    memset((void*)audio_dma_buffer, 0, sizeof(audio_dma_buffer));
    SCB_CleanDCache_by_Addr((uint32_t*)audio_dma_buffer, sizeof(audio_dma_buffer));

    // Retoma o DMA (tocará silêncio)
    HAL_I2S_DMAResume(&hi2s2);
}

void Audio_StartPlayback(const char* filename)
{
    if(!open_wav_file(filename)) {
        return;
    }

    // Limpa buffer com silêncio inicial
    memset((void*)audio_dma_buffer, 0, sizeof(audio_dma_buffer));

    // Pré-enche ambos os half-buffers
    uint32_t samples_written;

    // Primeira metade
    samples_written = fill_audio_tom(&audio_dma_buffer[0], HALF_BUFFER_SAMPLES);
    if(samples_written < HALF_BUFFER_SAMPLES) {
        memset((void*)&audio_dma_buffer[samples_written], 0,
               (HALF_BUFFER_SAMPLES - samples_written) * 4);
    }
    SCB_CleanDCache_by_Addr((uint32_t*)&audio_dma_buffer[0], HALF_BUFFER_SAMPLES * 4);

    // Segunda metade
    samples_written = fill_audio_tom(&audio_dma_buffer[HALF_BUFFER_SAMPLES], HALF_BUFFER_SAMPLES);
    if(samples_written < HALF_BUFFER_SAMPLES) {
        memset((void*)&audio_dma_buffer[HALF_BUFFER_SAMPLES + samples_written], 0,
               (HALF_BUFFER_SAMPLES - samples_written) * 4);
    }
    SCB_CleanDCache_by_Addr((uint32_t*)&audio_dma_buffer[HALF_BUFFER_SAMPLES], HALF_BUFFER_SAMPLES * 4);

    // Garante que o DMA está rodando
    HAL_I2S_DMAResume(&hi2s2);

    // Cria task do player se não existir
    if(audio_task_handle == NULL) {
        xTaskCreate(vAudioPlayerTask, "AudioPlayer", 4096, NULL,
                    configMAX_PRIORITIES - 1, &audio_task_handle);
        // Dá um pequeno delay para a task iniciar e ficar pronta
        vTaskDelay(pdMS_TO_TICKS(10));
    }

    // Sinaliza a task para começar (AGORA a task já está esperando)
    xSemaphoreGive(audio_start_semaphore);
}

uint8_t Audio_IsPlaying(void)
{
    return wav_player.is_playing;
}

